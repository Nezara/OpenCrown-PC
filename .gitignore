# Whitelist: only our own code, tools, plan and notes are versioned. No game bytes, assets, eboot or
# Ghidra databases ever enter the repo (users supply their own dump).
/*
!/.gitignore
!/.gitattributes
!/README.md
!/docs/
!/notes/
!/port/
!/linux-port/
!/android-port/
!/server/

/port/build/
/port/build*/
/linux-port/build*/
/linux-port/dist/
/android-port/build*/
/android-port/vita_data/
/android-port/mobile_data/
/Work/tools/paths.local.ps1
*.log
.env
/notes/raw/
__pycache__/
*.pyc
dist/
/android-port/vita_data/
